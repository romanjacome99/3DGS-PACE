 "_nostop_note": {
  "base": "agentic_gs_phase1/configs/real_fastergs_accel_aug_base_tandt.json",
  "change": "safety.hard_stop_gaussians = 8000000",
  "why": "ignatius is dense enough that the growth-oriented Faster-GS controller crosses the 3M rail before 30k: the protocol run ends at iteration 10000 with 2.77M Gaussians and the snapshot replay at 11.6k with 3.03M. This config lets the same controller run the full 30k so the comparison is at a matched iteration count.",
  "unchanged": "safety.hard_max_gaussians stays 3000000 because it normalises five observation features; moving it would rescale the policy's inputs and change the controller. The VRAM rails (target 20 GB, hard 24 GB) are untouched and can still stop the run."
 }
